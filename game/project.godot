; Engine configuration file.
; Проект игры «Тьма в глубине» (поток F плана review/07-next-steps.md).

config_version=5

[application]

config/name="Тьма в глубине"
config/description="Партийная тактическая RPG в изометрии: пролог и главы 1–5."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/input/input_setup.gd"
Game="*res://scripts/state/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[dotnet]

project/assembly_name="TmaGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/ui.ru.translation", "res://i18n/ui.en.translation", "res://i18n/combat.ru.translation", "res://i18n/combat.en.translation", "res://i18n/location.ru.translation", "res://i18n/location.en.translation")
locale/fallback="ru"

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
