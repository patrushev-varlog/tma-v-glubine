{
  "_doc": "Состояния участников. Ключи свойств и событий окончания — game/docs/COMBAT_DATA.md. value — число или кости, заданные тем, кто наложил состояние.",

  "prone":        {"defense_melee": 1, "defense_ranged": -1, "attack": -1, "turn_start": "stand_up", "ai_value": 2},
  "dodging":      {"defense": -1, "ends": ["own_turn_start"]},
  "hidden":       {"attack": 1, "untargetable": true, "ends": ["attack", "down"], "hide_expiry": true},
  "disengaged":   {"no_provoke": true, "ends": ["own_turn_start"]},
  "guided":       {"defense": 1, "ends": ["attacked", "src_turn_start"], "ai_value": 2},
  "taunted":      {"forced_target": true, "ends": ["own_turn_end"]},
  "raging":       {"melee_dmg": 1, "weapon_dr": 2, "preview_mitigation": 0.8, "ends": ["down"]},
  "reckless":     {"melee_attack": 1, "defense": 1, "ends": ["own_turn_start"]},
  "poison_ready": {"on_weapon_hit": [
                    {"op": "bonus_dice", "dice": "$value"},
                    {"op": "status", "to": "target", "status": "poisoned"}],
