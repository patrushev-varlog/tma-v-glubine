  "poisoned":     {"attack": -1, "ends": ["own_turn_end"]},
  "shadow_ready": {"on_weapon_hit": [{"op": "bonus_dice", "dice": "$value", "drain": true}], "ends": ["weapon_hit"]},
  "stunned":      {"skip_turn": true, "defense": 1, "no_reactions": true, "no_threat": true, "no_actions": true, "ends": ["down"]},
  "restrained":   {"immobile": true, "attack": -1, "defense": 1},
  "slowed":       {"ac": -2, "speed_mult": 0.5, "max_attacks": 1, "no_reactions": true, "turn_end_save": "wis"},
  "turned":       {"flee": true, "no_reactions": true, "no_threat": true, "ends": ["damaged"]},
  "shielded":     {"ac": "$value"},
  "spirit_weapon": {},
  "guardians":    {"aura_ability": "spirit_guardians"}
