<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Шаблон экспорта Android в Godot 4.7 собран под .NET 9: для Android нужен net9.0 (SDK 9 или новее) -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>StackSlice</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- GodotInk: рантайм Ink от inkle (ink-engine-runtime.dll), качается при первой сборке -->
  <Import Project="addons/GodotInk/GodotInk.props" />
</Project>
